# VITE_API_BASE_URL: Base URL for the Pickup Counter Express backend API.
# Leave blank or set to empty string to use relative proxy path (/products, /orders),
# or specify the Express server host (e.g. http://localhost:4000).
VITE_API_BASE_URL="http://localhost:4000"

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
